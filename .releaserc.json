{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/dungsil/dsh-plugins.git",
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "pkgRoot": "packages/locale-ko"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm exec oxfmt --write CHANGELOG.md && pnpm --filter @dungsil/dsh-plugin-locale-ko pack --pack-destination release"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "packages/locale-ko/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": ["release/*.tgz"],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
