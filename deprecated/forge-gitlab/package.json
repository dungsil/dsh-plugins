{
  "name": "@dungsil/dsh-plugin-forge-gitlab",
  "version": "0.1.3",
  "description": "GitLab provider for the DSH experimental forge registry, using glab on the host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "deprecated/forge-gitlab"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "execa": "10.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-experimental-forge": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "semver": "7.8.6",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-experimental-forge": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "market": false
}
