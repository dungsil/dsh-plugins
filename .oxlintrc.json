{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "ignorePatterns": ["deprecated/**", "packages/pstack/skills/**"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [
    {
      "files": ["**/test/**/*.{ts,tsx,js,mjs,cjs}", "**/*.{test,spec}.{ts,tsx,js,mjs,cjs}"],
      "rules": {
        "typescript/no-floating-promises": ["warn", { "ignoreVoid": false }]
      }
    },
    {
      "files": ["packages/**/*.{ts,tsx,js,mjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-primitives/**"],
                "message": "Use @dungsil/dsh-ui; expose missing primitives through tools/ui first."
              }
            ]
          }
        ]
      }
    }
  ]
}
