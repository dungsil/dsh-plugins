{
  "name": "@dungsil/dsh-plugins",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "release": "node scripts/release.mjs",
    "market:index": "node scripts/market-index.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks",
    "check": "node scripts/check.mjs",
    "check:fix": "pnpm lint:fix && pnpm check",
    "check:all": "node scripts/check.mjs --all"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.3-alpha.2",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.6",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lint-staged": "17.6.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "release-it": "21.1.3",
    "semver": "7.8.6",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --hide-all"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
