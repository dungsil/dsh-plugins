{
  "name": "@dungsil/dsh-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "release": "node scripts/release.mjs",
    "market:index": "node scripts/market-index.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks",
    "check": "pnpm format:check && turbo run typecheck test && pnpm lint"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.5",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "release-it": "21.1.2",
    "semver": "7.8.5",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
