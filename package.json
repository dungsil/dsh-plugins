{
  "name": "@dungsil/dsh-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/*.test.mjs && turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && oxfmt --write .",
    "release": "changeset publish",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
