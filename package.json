{
  "name": "@dungsil/dsh-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/*.test.mjs && turbo run test",
    "release": "node scripts/release.mjs",
    "market:index": "node scripts/market-index.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.5",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "release-it": "21.1.2",
    "semver": "7.8.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
