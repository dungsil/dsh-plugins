{
  "name": "@dungsil/dsh-plugin-i-have-adhd",
  "version": "0.4.0",
  "description": "Automatic ADHD-friendly responses for DeepSeek Harness, adapted from ayghri/i-have-adhd.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/i-have-adhd"
  },
  "files": [
    "dist",
    "locale",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.5"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "market": {
    "order": 4,
    "title": {
      "en": "ADHD-friendly responses",
      "ko": "ADHD 친화 응답",
      "zh": "ADHD 友好回复"
    },
    "description": {
      "en": "Turns on ADHD-friendly response formatting: one action first, short steps, and no preamble.",
      "ko": "행동을 먼저 제시하고 단계를 짧게 유지하는 ADHD 친화 응답 형식을 켭니다.",
      "zh": "启用 ADHD 友好的回复格式：优先给出行动，步骤简短，不加开场白。"
    },
    "category": "skills",
    "labels": [
      "accessibility"
    ],
    "keywords": [
      "adhd",
      "accessibility",
      "responses",
      "skills"
    ]
  }
}
