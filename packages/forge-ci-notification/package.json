{
  "name": "@dungsil/dsh-plugin-forge-ci-notification",
  "version": "0.1.0",
  "description": "Optional, deduplicated CI failure notices to agents for linked Forge pull requests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/forge-ci-notification"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-experimental-forge": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-experimental-forge-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.3-alpha.2",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "semver": "7.8.6",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0 || ^4.2.0-alpha.1",
    "@deepseek-ai/dsh-experimental-forge": "^0.2.2-rc.3 || ^0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3 || ^0.2.3-alpha.2"
  },
  "engines": {
    "dsh": "^0.2.2-rc.3",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "market": {
    "order": 14,
    "title": {
      "en": "Forge CI failure notifications",
      "ko": "Forge CI 실패 알림",
      "zh": "Forge CI 失败通知"
    },
    "description": {
      "en": "Optionally notify the active agent about failures in linked PR/MR checks, with durable deduplication and configurable wake behavior.",
      "ko": "연결된 PR/MR의 CI 실패를 에이전트의 다음 턴에 알리며, 중복 방지와 깨우기 여부를 설정할 수 있습니다.",
      "zh": "可选地向当前智能体报告关联 PR/MR 的 CI 检查失败，支持持久去重和可配置的唤醒行为。"
    },
    "category": "tools",
    "labels": [],
    "keywords": [
      "forge",
      "ci",
      "pull-request",
      "merge-request",
      "notification",
      "agent"
    ]
  }
}
