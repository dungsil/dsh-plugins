{
  "name": "@dungsil/dsh-plugin-ui-setting-skills",
  "version": "0.2.0",
  "description": "View loaded user skills in DeepSeek Harness settings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-setting-skills"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-native-command": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-client-ui-cot-translation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-config-editor": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.5"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "market": {
    "order": 7.2,
    "title": {
      "en": "Skills Settings",
      "ko": "스킬 설정",
      "zh": "技能设置"
    },
    "description": {
      "en": "View loaded skills from your shared agent and DSH skill directories in settings.",
      "ko": "설정 화면에서 공용 에이전트 및 DSH 스킬 경로에 로드된 스킬을 확인합니다.",
      "zh": "在设置中查看从共享代理和 DSH 技能目录加载的技能。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "skills",
      "settings",
      "ui"
    ]
  }
}
