{
  "name": "@dungsil/dsh-plugin-ui-image-paths",
  "version": "0.1.0",
  "description": "Resolve Markdown images against each message's recorded working directory.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-image-paths"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.2",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.1"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "market": {
    "order": 22,
    "title": {
      "en": "Image Paths",
      "ko": "이미지 경로 개선",
      "zh": "图片路径优化"
    },
    "description": {
      "en": "Display relative Markdown images using the working directory recorded for each message.",
      "ko": "메시지별로 기록된 작업 디렉터리를 기준으로 상대경로 마크다운 이미지를 표시합니다.",
      "zh": "根据每条消息记录的工作目录显示相对路径 Markdown 图片。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "image",
      "markdown",
      "worktree",
      "path"
    ]
  }
}
