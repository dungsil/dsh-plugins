{
  "name": "@dungsil/dsh-preset-ui",
  "version": "0.2.0",
  "description": "A preset that installs UI plugins for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/preset-ui"
  },
  "files": [
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dungsil/dsh-plugin-locale-ko": "workspace:*",
    "@dungsil/dsh-plugin-ui-model-picker": "workspace:*",
    "@dungsil/dsh-plugin-ui-model-settings": "workspace:*",
    "@dungsil/dsh-plugin-ui-setting-skills": "workspace:*",
    "@dungsil/dsh-plugin-ui-sidebar-inbox": "workspace:*",
    "@dungsil/dsh-plugin-ui-turn-rail-left": "workspace:*",
    "@dungsil/dsh-plugin-ui-usage": "workspace:*"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "market": {
    "order": 0,
    "title": {
      "en": "UI Preset",
      "ko": "UI 프리셋",
      "zh": "界面预设"
    },
    "description": {
      "en": "A preset that installs UI plugins for DeepSeek Harness.",
      "ko": "DeepSeek Harness UI 플러그인을 함께 설치하는 프리셋입니다.",
      "zh": "用于统一安装 DeepSeek Harness 界面插件的预设。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "preset",
      "bundle",
      "ui"
    ]
  }
}
