{
  "name": "@dungsil/dsh-preset-ui",
  "version": "0.0.0",
  "description": "A UI preset bundling seven existing DeepSeek Harness plugins without its own runtime implementation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/preset-ui"
  },
  "files": [
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dungsil/dsh-plugin-locale-ko": "workspace:*",
    "@dungsil/dsh-plugin-ui-model-picker": "workspace:*",
    "@dungsil/dsh-plugin-ui-model-settings": "workspace:*",
    "@dungsil/dsh-plugin-ui-setting-skills": "workspace:*",
    "@dungsil/dsh-plugin-ui-sidebar-inbox": "workspace:*",
    "@dungsil/dsh-plugin-ui-turn-rail-left": "workspace:*",
    "@dungsil/dsh-plugin-ui-worktree": "workspace:*"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "market": {
    "order": 0,
    "title": {
      "en": "UI Preset",
      "ko": "UI 프리셋",
      "zh": "界面预设"
    },
    "description": {
      "en": "Install Korean UI, Sidebar Inbox, Task Models UI, Skills Settings, Git Worktree UI, Model Picker, and Left Turn Rail together.",
      "ko": "한국어 UI, 사이드바 수신함, 상황별 모델, 스킬 설정, Git Worktree UI, 모델 피커, 왼쪽 턴 레일을 함께 설치합니다.",
      "zh": "一起安装韩语界面、侧边栏收件箱、任务模型设置、技能设置、Git 工作树界面、模型选择器和左侧轮次导航栏。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "preset",
      "bundle",
      "ui"
    ]
  }
}
