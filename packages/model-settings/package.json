{
  "name": "@dungsil/dsh-plugin-model-settings",
  "version": "0.1.0",
  "description": "Choose models by task in DeepSeek Harness settings, starting with session titles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/model-settings"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title-all-prompts-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "0.2.1-rc.5",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@types/react": "18.3.31",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-config-editor": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "market": {
    "order": 7,
    "title": {
      "en": "Task Models",
      "ko": "상황별 모델"
    },
    "description": {
      "en": "Choose a session title model without changing the conversation model.",
      "ko": "대화 모델을 바꾸지 않고 세션 제목 생성에 사용할 모델을 지정합니다."
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "models",
      "settings",
      "sessions",
      "titles"
    ]
  }
}
