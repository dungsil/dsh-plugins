{
  "name": "@dungsil/dsh-plugin-ui-usage",
  "version": "0.4.0",
  "description": "Recorded session token usage dashboard for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-usage"
  },
  "files": [
    "dist",
    "locale",
    "assets",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.2",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.5 || ^0.2.2-rc.1"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "market": {
    "order": 12,
    "title": {
      "en": "Usage Dashboard",
      "ko": "사용량 대시보드",
      "zh": "用量仪表盘",
      "ja": "使用量ダッシュボード",
      "es": "Panel de uso",
      "fr": "Tableau de bord d’utilisation",
      "de": "Nutzungsübersicht",
      "ru": "Панель использования",
      "pt": "Painel de uso"
    },
    "description": {
      "en": "View recorded session tokens, daily activity, and model usage from the sidebar.",
      "ko": "사이드바에서 세션에 기록된 토큰, 일별 추이, 모델별 사용량을 확인합니다.",
      "zh": "从侧边栏查看会话记录的令牌、每日趋势和模型用量。",
      "ja": "サイドバーから、セッションに記録されたトークン数、日別の推移、モデル別の使用量を確認します。",
      "es": "Consulta desde la barra lateral los tokens registrados en las sesiones, la actividad diaria y el uso por modelo.",
      "fr": "Consultez depuis la barre latérale les tokens enregistrés dans les sessions, l’activité quotidienne et l’utilisation par modèle.",
      "de": "Zeigen Sie aufgezeichnete Sitzungstokens, tägliche Aktivitäten und die Modellnutzung über die Seitenleiste an.",
      "ru": "Просматривайте записанные токены сеансов, ежедневную активность и использование моделей на боковой панели.",
      "pt": "Veja na barra lateral os tokens registrados nas sessões, a atividade diária e o uso por modelo."
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "usage",
      "tokens",
      "dashboard",
      "models"
    ]
  }
}
