{
  "name": "@dungsil/dsh-plugin-ui-worktree",
  "version": "0.1.0",
  "description": "Create and switch Git worktrees directly from the DeepSeek Harness composer, using the model only for optional branch naming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-worktree"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-worktree": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@types/react": "18.3.31",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "market": {
    "order": 8,
    "title": {
      "en": "Git Worktree UI",
      "ko": "Git Worktree UI",
      "zh": "Git 工作树界面"
    },
    "description": {
      "en": "Select, create, and switch Git worktrees next to the composer permission selector. The model only names branches when the name is empty.",
      "ko": "입력창의 권한 선택 옆에서 Git worktree를 선택·생성·전환합니다. 이름을 비운 경우에만 모델이 브랜치 이름을 정합니다.",
      "zh": "在输入框的权限选择器旁选择、创建和切换 Git 工作树。仅在名称为空时由模型生成分支名称。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "git",
      "worktree",
      "composer"
    ]
  }
}
