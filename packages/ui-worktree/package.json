    "@deepseek-ai/dsh-experimental-worktree": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "market": {
    "order": 8,
    "title": {
      "en": "Git Worktree UI",
      "ko": "Git Worktree UI",
      "zh": "Git 工作树界面"
    },
    "description": {
      "en": "Adds AI branch naming and safe archive cleanup to the official Forge worktree panel.",
      "ko": "공식 Forge 워크트리 패널에 AI 브랜치 이름과 안전한 보관 정리를 추가합니다.",
      "zh": "为官方 Forge 工作树面板添加 AI 分支命名和安全归档清理。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "git",
      "worktree",
      "composer"
    ]
  }
