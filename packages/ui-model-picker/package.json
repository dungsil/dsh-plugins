{
  "name": "@dungsil/dsh-plugin-ui-model-picker",
  "version": "0.3.0",
  "description": "Model and reasoning effort picker for the DeepSeek Harness composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-model-picker"
  },
  "files": [
    "dist",
    "locale",
    "assets",
    "cordis.patch.yml",
    "THIRD-PARTY-LICENSES"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5 || ^0.2.2-rc.1"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "market": {
    "order": 9,
    "title": {
      "en": "Model Picker",
      "ko": "모델 피커",
      "zh": "模型选择器",
      "ja": "モデル選択",
      "es": "Selector de modelos",
      "fr": "Sélecteur de modèles",
      "de": "Modellauswahl",
      "ru": "Выбор модели",
      "pt": "Seletor de modelos"
    },
    "description": {
      "en": "A compact composer picker with model menus and a reasoning effort slider.",
      "ko": "입력창에서 모델 메뉴와 추론 강도 슬라이더를 사용합니다.",
      "zh": "在输入框中使用模型菜单和推理强度滑块。",
      "ja": "入力欄でモデルメニューと推論強度スライダーを使えるコンパクトな選択ツールです。",
      "es": "Un selector compacto en el cuadro de entrada con menús de modelos y un control deslizante de esfuerzo de razonamiento.",
      "fr": "Un sélecteur compact dans la zone de saisie avec des menus de modèles et un curseur d’effort de raisonnement.",
      "de": "Eine kompakte Auswahl im Eingabefeld mit Modellmenüs und einem Schieberegler für den Denkaufwand.",
      "ru": "Компактный инструмент в поле ввода с меню моделей и ползунком глубины рассуждений.",
      "pt": "Um seletor compacto no campo de entrada com menus de modelos e um controle deslizante de esforço de raciocínio."
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "models",
      "reasoning",
      "composer"
    ]
  }
}
