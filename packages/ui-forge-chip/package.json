{
  "name": "@dungsil/dsh-plugin-ui-forge-chip",
  "version": "0.3.0",
  "description": "Composer commit, push and PR chips that run Git on the host with Forge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-forge-chip"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-config-editor": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-experimental-client-ui-forge": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-experimental-forge-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "@dungsil/dsh-plugin-forge-forgejo": "workspace:*",
    "@dungsil/dsh-plugin-forge-gitea": "workspace:*",
    "@dungsil/dsh-plugin-model-settings": "workspace:*",
    "@dungsil/dsh-plugin-server": "workspace:*",
    "@dungsil/dsh-task-prompts": "workspace:*",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0 || ^4.2.0-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1 || ^0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1 || ^0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1 || ^0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "~3.19.0 || ~3.20.0-alpha.1"
  },
  "engines": {
    "dsh": "^0.2.2-rc.2",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-experimental-client-ui-forge"
      ]
    }
  },
  "market": {
    "title": {
      "en": "Forge Chips",
      "ko": "Forge 칩",
      "zh": "Forge 操作按钮",
      "ja": "Forge チップ",
      "es": "Chips de Forge",
      "fr": "Pastilles Forge",
      "de": "Forge-Chips",
      "ru": "Кнопки Forge",
      "pt": "Chips do Forge"
    },
    "description": {
      "en": "Commit, push and create or view PRs from compact composer chips. Git runs on the host and an auxiliary model writes commit messages.",
      "ko": "입력창 칩으로 커밋·푸시·PR 생성과 조회를 실행합니다. Git은 호스트가 직접 실행하고 커밋 메시지는 보조 모델이 작성합니다.",
      "zh": "通过输入框按钮提交、推送、创建或查看 PR。Git 由主机直接执行，提交信息由辅助模型生成。",
      "ja": "入力欄のチップからコミット、プッシュ、PR の作成や表示を行います。Git はホストが直接実行し、コミットメッセージは補助モデルが作成します。",
      "es": "Haz commit, push y crea o consulta PR desde chips del cuadro de entrada. Git se ejecuta en el host y un modelo auxiliar redacta los mensajes de commit.",
      "fr": "Effectuez des commits et des push, créez ou consultez des PR depuis des pastilles de la zone de saisie. Git s’exécute sur l’hôte et un modèle auxiliaire rédige les messages de commit.",
      "de": "Committen, pushen und PRs erstellen oder anzeigen über Chips im Eingabefeld. Git läuft auf dem Host, ein Hilfsmodell schreibt die Commit-Nachrichten.",
      "ru": "Делайте коммиты, отправляйте изменения, создавайте и просматривайте PR с помощью кнопок в поле ввода. Git выполняется на хосте, а сообщения коммитов пишет вспомогательная модель.",
      "pt": "Faça commit, push e crie ou veja PRs em chips do campo de mensagem. O Git roda no host e um modelo auxiliar escreve as mensagens de commit."
    },
    "category": "ui",
    "keywords": [
      "forge",
      "commit",
      "pull-request",
      "chip"
    ]
  }
}
