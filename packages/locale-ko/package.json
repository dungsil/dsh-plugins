{
  "name": "@dungsil/dsh-plugin-locale-ko",
  "version": "0.6.0",
  "description": "Korean UI language pack for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/locale-ko"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml",
    "NOTICE",
    "assets/fonts/*.txt"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@dungsil/dsh-plugin-korean-ime": "workspace:^",
    "@dungsil/dsh-plugin-yoonmoon": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "happy-dom": "21.0.4",
    "semver": "7.8.5",
    "tsdown": "0.23.4",
    "yaml": "2.9.0"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "market": {
    "order": 1,
    "title": {
      "en": "Korean UI",
      "ko": "한국어 UI",
      "zh": "韩语界面"
    },
    "description": {
      "en": "Korean interface strings for DeepSeek Harness, including the plugin pages and the Korean IME and writing skills.",
      "ko": "DSH 웹 UI를 한국어로 표시하고, 플러그인 관리 페이지 번역과 한국어 IME·윤문 스킬을 함께 제공합니다.",
      "zh": "为 DeepSeek Harness 提供韩语界面，包含插件管理页面翻译、韩语输入法和写作技能。"
    },
    "category": "ui",
    "labels": [
      "korean"
    ],
    "keywords": [
      "locale",
      "i18n",
      "korean",
      "ui"
    ]
  }
}
