{
  "name": "@dungsil/dsh-plugin-ui-conversation-hero",
  "version": "0.0.0",
  "description": "Limit the blank conversation composer to a centered, readable width without altering active chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-conversation-hero"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.23.7"
  },
  "engines": {
    "dsh": "^0.2.2-rc.3",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "market": {
    "order": 8.4,
    "title": {
      "en": "Centered New Conversation",
      "ko": "새 대화 중앙 배치",
      "zh": "新会话居中布局"
    },
    "description": {
      "en": "Keep the empty conversation's composer at a readable width, without remounting the editor when the conversation starts.",
      "ko": "새 대화의 입력창 너비를 읽기 편하게 제한하고 첫 메시지 전송 시 입력창을 다시 생성하지 않습니다.",
      "zh": "限制空白会话输入框的最大宽度，在开始对话时保留原有输入框。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "conversation",
      "hero",
      "composer",
      "layout",
      "width"
    ]
  }
}
