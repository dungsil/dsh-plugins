{
  "name": "@dungsil/dsh-plugin-ui-model-settings",
  "version": "0.8.0",
  "description": "Task model and instruction settings UI for DeepSeek Harness, including the native pwsh tool description.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-model-settings"
  },
  "files": [
    "dist",
    "locale",
    "assets",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@dungsil/dsh-plugin-model-settings": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5 || ^0.2.2-rc.1"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "market": {
    "order": 7.1,
    "title": {
      "en": "Models and instructions by task",
      "ko": "상황 별 모델 및 지침",
      "zh": "任务模型与指令"
    },
    "description": {
      "en": "Configure task models, reasoning effort, and instructions, including the native pwsh tool description. Includes the settings API.",
      "ko": "작업별 모델·추론 수준·지침과 pwsh 기본 도구 설명을 설정합니다. 설정 API를 함께 설치합니다.",
      "zh": "设置各任务的模型、推理级别和指令，以及 pwsh 默认工具说明。同时安装设置 API。"
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "models",
      "settings",
      "sessions",
      "titles",
      "ui"
    ]
  }
}
