{
  "name": "@dungsil/dsh-plugin-yoonmoon",
  "version": "0.6.1",
  "description": "Korean writing skills for DeepSeek Harness, adapted from amondnet/yoonmoon.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/yoonmoon"
  },
  "files": [
    "dist",
    "locale",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title-all-prompts-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@dungsil/dsh-plugin-model-settings": "workspace:*",
    "@dungsil/dsh-task-prompts": "workspace:*",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5 || ^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "market": {
    "order": 3,
    "title": {
      "en": "Yoonmoon",
      "ko": "윤문",
      "zh": "韩语润色",
      "ja": "Yoonmoon",
      "es": "Yoonmoon",
      "fr": "Yoonmoon",
      "de": "Yoonmoon",
      "ru": "Yoonmoon",
      "pt": "Yoonmoon"
    },
    "description": {
      "en": "Six Korean writing skills for proofreading, translation cleanup, AI-style removal, and style conversion.",
      "ko": "교정·번역투 제거·AI 문체 제거·문체 변환을 다루는 한국어 글다듬기 스킬 6개를 제공합니다.",
      "zh": "提供六项韩语写作技能，涵盖校对、翻译腔修正、AI 文风去除和文体转换。",
      "ja": "校正、翻訳調の修正、AI 文体の除去、文体変換のための韓国語文章作成スキルを 6 つ提供します。",
      "es": "Seis habilidades de escritura en coreano para corregir textos, depurar traducciones, eliminar el estilo de IA y convertir estilos.",
      "fr": "Six compétences de rédaction en coréen pour la relecture, la correction des traductions, la suppression du style IA et la conversion de style.",
      "de": "Sechs koreanische Schreib-Skills für Korrekturlesen, Übersetzungsüberarbeitung, Entfernung von KI-Stil und Stilumwandlung.",
      "ru": "Шесть навыков работы с корейскими текстами: корректура, исправление переводных оборотов, устранение стиля ИИ и преобразование стиля.",
      "pt": "Seis habilidades de escrita em coreano para revisão, correção de traduções, remoção do estilo de IA e conversão de estilo."
    },
    "category": "skills",
    "labels": [
      "korean"
    ],
    "keywords": [
      "korean",
      "writing",
      "proofreading",
      "style"
    ]
  }
}
