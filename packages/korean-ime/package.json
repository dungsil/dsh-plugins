{
  "name": "@dungsil/dsh-plugin-korean-ime",
  "version": "0.4.0",
  "description": "Korean IME Enter handling for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/korean-ime"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-tsdown": "workspace:*",
    "tsdown": "0.23.4"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "market": {
    "order": 2,
    "title": {
      "en": "Korean IME",
      "ko": "한국어 IME",
      "zh": "韩语输入法"
    },
    "description": {
      "en": "Sends the message when Enter commits a Korean IME composition, without changing other key behavior.",
      "ko": "한글 조합을 Enter로 확정할 때 메시지를 전송하고, 다른 입력 동작은 바꾸지 않습니다.",
      "zh": "按 Enter 确认韩语输入法组字时发送消息，不改变其他按键行为。"
    },
    "category": "ui",
    "labels": [
      "korean"
    ],
    "keywords": [
      "ime",
      "korean",
      "enter",
      "input"
    ]
  }
}
