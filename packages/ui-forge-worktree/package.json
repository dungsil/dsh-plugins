{
  "name": "@dungsil/dsh-plugin-ui-forge-worktree",
  "version": "0.0.0",
  "description": "Choose the current branch or a new Git worktree from the composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungsil/dsh-plugins.git",
    "directory": "packages/ui-forge-worktree"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./dist/icon.svg"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@dungsil/dsh-tsconfig": "workspace:*",
    "@dungsil/dsh-ui": "workspace:*",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.23.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1"
  },
  "icon": "./dist/icon.svg",
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-experimental-client-ui-forge"
      ]
    }
  },
  "market": {
    "order": 9,
    "title": {
      "en": "Worktree picker",
      "ko": "워크트리 선택기",
      "zh": "工作树选择器",
      "ja": "ワークツリー選択",
      "es": "Selector de árboles de trabajo",
      "fr": "Sélecteur d’arbres de travail",
      "de": "Worktree-Auswahl",
      "ru": "Выбор рабочего дерева",
      "pt": "Seletor de árvores de trabalho"
    },
    "description": {
      "en": "Choose the current branch or a new Git worktree from the composer.",
      "ko": "입력창에서 현재 브랜치나 새 Git 워크트리를 선택합니다.",
      "zh": "在输入框中选择当前分支或新建 Git 工作树。",
      "ja": "入力欄から現在のブランチまたは新しい Git ワークツリーを選択します。",
      "es": "Elige la rama actual o un nuevo árbol de trabajo de Git desde el cuadro de entrada.",
      "fr": "Choisissez la branche actuelle ou un nouvel arbre de travail Git depuis la zone de saisie.",
      "de": "Wählen Sie den aktuellen Branch oder einen neuen Git-Worktree im Eingabefeld aus.",
      "ru": "Выберите текущую ветку или новое рабочее дерево Git в поле ввода.",
      "pt": "Escolha a branch atual ou uma nova árvore de trabalho do Git no campo de mensagem."
    },
    "category": "ui",
    "labels": [],
    "keywords": [
      "git",
      "worktree",
      "composer"
    ]
  }
}
