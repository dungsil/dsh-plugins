{
  "$schema": "https://turborepo.org/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "5GB",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
