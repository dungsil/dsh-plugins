{
  "$schema": "https://turborepo.org/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "5GB",
  "globalDependencies": ["**/.env", "tools/tsconfig/**"],
  "tasks": {
    "dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
